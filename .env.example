# Copier vers .env (ignore par Git). Ne jamais versionner une vraie cle.
# Choisir UN fournisseur. Noms conformes a agent/app/config.py.
LLM_PROVIDER=mistral-api
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-2603
MISTRAL_API_KEY=REMPLACER_PAR_SA_CLE
# Alternative : fichier prive Windows contenant la cle ; vider MISTRAL_API_KEY.
MISTRAL_API_KEY_FILE=
LLM_TIMEOUT_SECONDS=60

# Pour un serveur local compatible OpenAI, par exemple Ollama, remplacer les
# lignes du fournisseur ci-dessus par :
# LLM_PROVIDER=local
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=nom-du-modele-installe
# LLM_API_KEY_FILE=
# LLM_TIMEOUT_SECONDS=180
# Le moteur et le modele local sont installes/demarres manuellement.

KUBERNETES_NAMESPACE=kubeai
UPSTREAM_TIMEOUT_SECONDS=5
METRICS_MAX_AGE_SECONDS=60
KUBEAI_DISPLAY_TIMEZONE=Europe/Zurich
