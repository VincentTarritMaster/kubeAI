# Configuration d'exemple. Ne place aucun secret réel dans ce fichier.
MIMIR_URL=http://mimir.monitoring.svc:9009/prometheus
LOKI_URL=http://loki.monitoring.svc.cluster.local:3100
KUBERNETES_NAMESPACE=kubeai
UPSTREAM_TIMEOUT_SECONDS=5
METRICS_MAX_AGE_SECONDS=60
LLM_PROVIDER=mistral
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-2603
LLM_TIMEOUT_SECONDS=60
# Valeur volontairement fictive. En production, fournir la clé par variable
# d'environnement ou par Secret Kubernetes monté en fichier, jamais dans Git.
MISTRAL_API_KEY=remplacer-par-une-cle-privee
MISTRAL_API_KEY_FILE=/var/run/secrets/kubeai-mistral/api-key
# Option locale explicite : LLM_PROVIDER=apertus, LLM_BASE_URL,
# LLM_MODEL, LLM_API_KEY_FILE et LLM_TIMEOUT_SECONDS.
