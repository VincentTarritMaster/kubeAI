logging {
  level = "info"
}

// Tous les namespaces du cluster observé.
discovery.kubernetes "pods" {
  role = "pod"
}

discovery.relabel "pod_logs" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_node_name"]
    target_label  = "node"
  }
  rule {
    target_label = "job"
    replacement  = "kubernetes-pods"
  }
}

loki.source.kubernetes "pods" {
  targets    = discovery.relabel.pod_logs.output
  forward_to = [loki.write.remote.receiver]
}

loki.write "remote" {
  external_labels = {"cluster" = sys.env("OBSERVED_CLUSTER")}
  endpoint {
    url = sys.env("LOKI_WRITE_URL")
    tls_config {
      ca_file     = "/etc/alloy/mtls/ca.crt"
      cert_file   = "/etc/alloy/mtls/client.crt"
      key_file    = "/etc/alloy/mtls/client.key"
      server_name = "loki.kubeai.svc"
    }
  }
}

// Métriques applicatives opt-in de tous les namespaces.
discovery.relabel "annotated_pods" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_pod_phase"]
    action        = "keep"
    regex         = "Running"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_scrape"]
    action        = "keep"
    regex         = "true"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_port"]
    action        = "keep"
    regex         = "([1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_path"]
    target_label  = "__metrics_path__"
    regex         = "(/[A-Za-z0-9._~/-]+)"
    replacement   = "$1"
  }
  rule {
    source_labels = ["__address__", "__meta_kubernetes_pod_annotation_prometheus_io_port"]
    target_label  = "__address__"
    regex         = "([^:]+)(:[0-9]+)?;([1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])"
    replacement   = "$1:$3"
  }
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }
}

prometheus.scrape "annotated_pods" {
  targets         = discovery.relabel.annotated_pods.output
  forward_to      = [prometheus.remote_write.remote.receiver]
  job_name        = "kubernetes-pods-annotated"
  scrape_interval = "30s"
}

// cAdvisor via le proxy API, en lecture seule.
discovery.kubernetes "nodes" {
  role = "node"
}

discovery.relabel "cadvisor" {
  targets = discovery.kubernetes.nodes.targets

  rule {
    source_labels = ["__meta_kubernetes_node_name"]
    target_label  = "node"
  }
  rule {
    target_label = "__address__"
    replacement  = "kubernetes.default.svc:443"
  }
  rule {
    source_labels = ["__meta_kubernetes_node_name"]
    regex         = "(.+)"
    target_label  = "__metrics_path__"
    replacement   = "/api/v1/nodes/$1/proxy/metrics/cadvisor"
  }
  rule {
    target_label = "__scheme__"
    replacement  = "https"
  }
}

prometheus.scrape "cadvisor" {
  targets           = discovery.relabel.cadvisor.output
  forward_to        = [prometheus.remote_write.remote.receiver]
  job_name          = "kubernetes-cadvisor"
  scrape_interval   = "30s"
  scheme            = "https"
  bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
  tls_config {
    ca_file = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
  }
}

prometheus.scrape "kube_state_metrics" {
  targets         = [{"__address__" = "kube-state-metrics.collecte.svc.cluster.local:8080"}]
  forward_to      = [prometheus.remote_write.remote.receiver]
  job_name        = "kube-state-metrics"
  scrape_interval = "15s"
}

prometheus.remote_write "remote" {
  external_labels = {"cluster" = sys.env("OBSERVED_CLUSTER")}
  endpoint {
    url = sys.env("MIMIR_WRITE_URL")
    tls_config {
      ca_file     = "/etc/alloy/mtls/ca.crt"
      cert_file   = "/etc/alloy/mtls/client.crt"
      key_file    = "/etc/alloy/mtls/client.key"
      server_name = "mimir.kubeai.svc"
    }
  }
}
