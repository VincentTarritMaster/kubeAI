# Profil externe par défaut du backend commun kubeAI.
KUBEAI_SUPERVISION_CLUSTER=kubeai-supervision
KUBEAI_OBSERVED_CLUSTER=kubeai-observed
KUBEAI_CHAT_MODE=agent
KUBERNETES_NAMESPACE=applications
LLM_PROVIDER=mistral-api
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-2603
MISTRAL_API_KEY=
MISTRAL_API_KEY_FILE=/var/run/secrets/kubeai-mistral/api-key
LLM_TIMEOUT_SECONDS=60
